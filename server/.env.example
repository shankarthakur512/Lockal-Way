NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Public frontend origin, comma-separated if you intentionally allow multiple origins.
CORS_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

ACCESS_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_me
REFRESH_TOKEN_EXPIRY=10d
OTP_TOKEN_SECRET=replace_me

STRIPE_SECRET_KEY=sk_test_replace_me

MAIL_USER=replace_me@example.com
MAIL_PASS=replace_me

CLOUDNARY_CLOUD_NAME=replace_me
CLOUDNARY_API_KEY=replace_me
CLOUDNARY_API_SECRET=replace_me

# Optional: only required if the AI assistant stays enabled.
GEMINI_API_KEY=
